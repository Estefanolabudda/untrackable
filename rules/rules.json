{
  "schemaVersion": 1,
  "rules": [
    {
      "id": "utm",
      "description": "Google Analytics / generic campaign parameters (utm_*)",
      "mode": "clean",
      "params": [
        "utm_source",
        "utm_medium",
        "utm_campaign",
        "utm_term",
        "utm_content",
        "utm_id",
        "utm_name",
        "utm_cid",
        "utm_reader",
        "utm_referrer",
        "utm_social",
        "utm_social-type",
        "utm_brand",
        "utm_place",
        "utm_pubreferrer",
        "utm_swu",
        "utm_viz_id",
        "utm_source_platform",
        "utm_creative_format",
        "utm_marketing_tactic"
      ],
      "prefixes": ["utm_"]
    },
    {
      "id": "click-ids",
      "description": "Advertising click identifiers (Google, Meta, Microsoft, TikTok, X, Yandex, LinkedIn, Reddit)",
      "mode": "clean",
      "params": [
        "fbclid",
        "gclid",
        "gclsrc",
        "dclid",
        "gbraid",
        "wbraid",
        "gad_source",
        "gad_campaignid",
        "msclkid",
        "ttclid",
        "twclid",
        "yclid",
        "ysclid",
        "li_fat_id",
        "rdt_cid",
        "epik",
        "srsltid"
      ]
    },
    {
      "id": "email-marketing",
      "description": "Newsletter and marketing automation identifiers (Mailchimp, HubSpot, Marketo, Vero, Omeda, Openstat)",
      "mode": "clean",
      "params": [
        "mc_cid",
        "mc_eid",
        "_hsenc",
        "_hsmi",
        "__hssc",
        "__hstc",
        "__hsfp",
        "hsctatracking",
        "mkt_tok",
        "vero_id",
        "vero_conv",
        "oly_anon_id",
        "_openstat",
        "wickedid",
        "rb_clickid",
        "_ga",
        "_gl"
      ]
    },
    {
      "id": "share-youtube-spotify",
      "description": "Share-sheet identifiers that link a shared URL back to the sharer",
      "mode": "clean",
      "domains": ["youtube.com", "youtu.be", "spotify.com"],
      "params": ["si"]
    },
    {
      "id": "share-instagram",
      "description": "Instagram share identifiers",
      "mode": "clean",
      "domains": ["instagram.com"],
      "params": ["igsh", "igshid"]
    },
    {
      "id": "share-x",
      "description": "X / Twitter share tracking",
      "mode": "clean",
      "domains": ["x.com", "twitter.com"],
      "params": ["s", "t"]
    },
    {
      "id": "strict-generic",
      "description": "Additional referral and analytics parameters (Matomo, Piwik, HubSpot Ads, comScore, Adobe, Branch, AT Internet, Alibaba). Strict mode only because some sites reuse these names functionally.",
      "mode": "strict",
      "params": [
        "ref",
        "ref_src",
        "ref_url",
        "referrer",
        "spm",
        "scm",
        "trk",
        "trkcampaign",
        "trackingid",
        "cmpid",
        "xtor",
        "ncid",
        "s_kwcid",
        "ef_id",
        "_branch_match_id",
        "_branch_referrer",
        "at_medium",
        "at_campaign",
        "sr_share",
        "igshid",
        "mibextid",
        "pk_campaign",
        "pk_kwd",
        "pk_keyword",
        "pk_source",
        "pk_medium",
        "pk_content",
        "pk_cid",
        "mtm_campaign",
        "mtm_keyword",
        "mtm_source",
        "mtm_medium",
        "mtm_content",
        "mtm_cid",
        "mtm_group",
        "mtm_placement",
        "piwik_campaign",
        "piwik_kwd",
        "hsa_acc",
        "hsa_cam",
        "hsa_grp",
        "hsa_ad",
        "hsa_src",
        "hsa_tgt",
        "hsa_kw",
        "hsa_mt",
        "hsa_net",
        "hsa_ver",
        "itm_source",
        "itm_medium",
        "itm_campaign",
        "itm_content",
        "itm_term",
        "oly_enc_id"
      ],
      "prefixes": ["pk_", "mtm_", "piwik_", "hsa_", "itm_", "ns_"]
    },
    {
      "id": "strict-amazon",
      "description": "Amazon referral, placement and affiliate parameters",
      "mode": "strict",
      "domains": [
        "amazon.com",
        "amazon.de",
        "amazon.co.uk",
        "amazon.fr",
        "amazon.it",
        "amazon.es",
        "amazon.nl",
        "amazon.ca",
        "amazon.com.au",
        "amazon.co.jp",
        "amazon.in",
        "amazon.pl",
        "amazon.se",
        "amazon.com.be",
        "amazon.at"
      ],
      "params": [
        "_encoding",
        "content-id",
        "crid",
        "dib",
        "dib_tag",
        "qid",
        "sprefix",
        "sr",
        "tag",
        "linkcode",
        "linkid",
        "ascsubtag",
        "creative",
        "creativeasin",
        "pf_rd_i",
        "pf_rd_m",
        "pf_rd_p",
        "pf_rd_r",
        "pf_rd_s",
        "pf_rd_t",
        "pd_rd_i",
        "pd_rd_r",
        "pd_rd_w",
        "pd_rd_wg",
        "pd_rd_plhdr"
      ],
      "prefixes": ["pf_rd_", "pd_rd_"]
    },
    {
      "id": "strict-google-search",
      "description": "Google Search telemetry parameters (sa/usg are kept: google.com/url needs them for its redirect)",
      "mode": "strict",
      "domains": ["google.com", "google.de", "google.co.uk", "google.fr", "google.at", "google.ch"],
      "params": [
        "ved",
        "ei",
        "sca_esv",
        "sxsrf",
        "oq",
        "gs_lp",
        "gs_lcrp",
        "sclient",
        "uact",
        "bih",
        "biw",
        "iflsig",
        "rlz",
        "sourceid",
        "aqs"
      ]
    },
    {
      "id": "strict-social",
      "description": "Facebook, LinkedIn, TikTok and Reddit share parameters",
      "mode": "strict",
      "domains": ["facebook.com", "linkedin.com", "tiktok.com", "reddit.com"],
      "params": [
        "__tn__",
        "__cft__[0]",
        "rdid",
        "refid",
        "lipi",
        "_r",
        "_t",
        "is_from_webapp",
        "sender_device",
        "is_copy_url",
        "share_app_id",
        "share_id"
      ]
    },
    {
      "id": "strict-ebay",
      "description": "eBay tracking and partner network parameters",
      "mode": "strict",
      "domains": ["ebay.com", "ebay.de", "ebay.co.uk", "ebay.fr", "ebay.it", "ebay.es", "ebay.at"],
      "params": ["_trkparms", "_trksid", "amdata", "mkcid", "mkevt", "mkrid", "campid", "toolid", "customid"]
    },
    {
      "id": "strict-aliexpress",
      "description": "AliExpress recommendation and affiliate parameters",
      "mode": "strict",
      "domains": ["aliexpress.com", "aliexpress.us"],
      "params": [
        "algo_pvid",
        "algo_exp_id",
        "pdp_npi",
        "pdp_ext_f",
        "gatewayadapt",
        "aff_fcid",
        "aff_fsk",
        "aff_platform",
        "aff_trace_key"
      ],
      "prefixes": ["aff_"]
    }
  ],
