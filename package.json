{
  "name": "untrackable-monorepo",
  "private": true,
  "description": "Untrackable \u2013 privacy by default, zero friction. Removes tracking parameters from URLs.",
  "license": "MIT",
  "workspaces": [
    "packages/core",
    "apps/browser-extension"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm run build --workspace apps/browser-extension",
    "typecheck": "tsc -p packages/core && tsc -p apps/browser-extension",
    "test": "vitest run",
    "test:e2e": "npm run build && node --test --test-concurrency=1 apps/browser-extension/e2e/extension.test.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "test:conformance": "node scripts/differential.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/chrome": "0.3.7",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "playwright": "1.63.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "type": "module"
}
