{
  "description": "Shared conformance fixtures for all cleaning engine implementations. All URLs are synthetic. Fields: input, mode (default clean), exceptions (default []), expected (resulting URL), status, removed (optional list of raw keys, in order), reason (optional).",
  "cases": [
    {
      "name": "basic utm removal keeps functional id",
      "input": "https://example.com/article?utm_source=newsletter&utm_medium=email&id=123",
      "expected": "https://example.com/article?id=123",
      "status": "cleaned",
      "removed": ["utm_source", "utm_medium"]
    },
    {
      "name": "all five classic utm parameters",
      "input": "https://example.com/?utm_source=a&utm_medium=b&utm_campaign=c&utm_term=d&utm_content=e",
      "expected": "https://example.com/",
      "status": "cleaned",
      "removed": ["utm_source", "utm_medium", "utm_campaign", "utm_term", "utm_content"]
    },
    {
      "name": "unknown utm_ parameter removed via prefix",
      "input": "https://example.com/page?utm_newthing=1&q=shoes",
      "expected": "https://example.com/page?q=shoes",
      "status": "cleaned",
      "removed": ["utm_newthing"]
    },
    {
      "name": "fbclid only",
      "input": "https://example.com/post/42?fbclid=IwAR0abcDEF",
      "expected": "https://example.com/post/42",
      "status": "cleaned",
      "removed": ["fbclid"]
    },
    {
      "name": "gclid and msclkid among functional params",
      "input": "https://shop.example/products?category=boots&gclid=Cj0KCQ&size=42&msclkid=abc",
      "expected": "https://shop.example/products?category=boots&size=42",
      "status": "cleaned",
      "removed": ["gclid", "msclkid"]
    },
    {
      "name": "mailchimp ids",
      "input": "https://example.org/news?mc_cid=1a2b3c&mc_eid=4d5e6f",
      "expected": "https://example.org/news",
      "status": "cleaned",
      "removed": ["mc_cid", "mc_eid"]
    },
    {
      "name": "case-insensitive parameter names",
      "input": "https://example.com/?UTM_SOURCE=x&Utm_Medium=y&FBCLID=z&keep=1",
      "expected": "https://example.com/?keep=1",
      "status": "cleaned",
      "removed": ["UTM_SOURCE", "Utm_Medium", "FBCLID"]
    },
    {
      "name": "percent-encoded parameter name",
      "input": "https://example.com/?utm%5Fsource=x&id=7",
      "expected": "https://example.com/?id=7",
      "status": "cleaned",
      "removed": ["utm%5Fsource"]
    },
    {
      "name": "duplicate tracking parameters all removed",
      "input": "https://example.com/?utm_source=a&id=1&utm_source=b",
      "expected": "https://example.com/?id=1",
      "status": "cleaned",
      "removed": ["utm_source", "utm_source"]
    },
    {
      "name": "duplicate functional parameters preserved in order",
      "input": "https://example.com/search?tag=a&utm_medium=x&tag=b",
      "expected": "https://example.com/search?tag=a&tag=b",
      "status": "cleaned",
      "removed": ["utm_medium"]
    },
    {
      "name": "empty tracking value and key without equals sign",
      "input": "https://example.com/?utm_source=&fbclid&a=",
      "expected": "https://example.com/?a=",
      "status": "cleaned",
      "removed": ["utm_source", "fbclid"]
    },
    {
      "name": "empty segments are preserved",
      "input": "https://example.com/?a=1&&utm_source=x&b=2",
      "expected": "https://example.com/?a=1&&b=2",
      "status": "cleaned",
      "removed": ["utm_source"]
    },
    {
      "name": "parameter order preserved",
      "input": "https://example.com/?z=26&utm_campaign=c&a=1&m=13",
      "expected": "https://example.com/?z=26&a=1&m=13",
      "status": "cleaned",
      "removed": ["utm_campaign"]
    },
    {
      "name": "fragment preserved in clean mode",
      "input": "https://example.com/docs?utm_source=x#section-2",
      "expected": "https://example.com/docs#section-2",
      "status": "cleaned",
      "removed": ["utm_source"]
    },
    {
      "name": "param-shaped fragment untouched in clean mode",
      "input": "https://example.com/a#utm_source=x",
      "expected": "https://example.com/a#utm_source=x",
      "status": "unchanged"
    },
    {
      "name": "param-shaped fragment cleaned in strict mode",
      "input": "https://example.com/a?id=1#utm_source=x&utm_medium=y",
      "mode": "strict",
      "expected": "https://example.com/a?id=1",
      "status": "cleaned",
      "removed": ["utm_source", "utm_medium"]
    },
    {
      "name": "xtor fragment cleaned in strict mode keeps other fragment params",
      "input": "https://news.example/article.html#xtor=RSS-3208&page=2",
      "mode": "strict",
      "expected": "https://news.example/article.html#page=2",
      "status": "cleaned",
      "removed": ["xtor"]
    },
    {
      "name": "SPA hash route never modified, even in strict mode",
      "input": "https://app.example/#/inbox?utm_source=x",
      "mode": "strict",
      "expected": "https://app.example/#/inbox?utm_source=x",
      "status": "unchanged"
    },
    {
      "name": "text fragment never modified",
      "input": "https://example.com/page?utm_source=x#:~:text=hello",
      "mode": "strict",
      "expected": "https://example.com/page#:~:text=hello",
      "status": "cleaned",
      "removed": ["utm_source"]
    },
    {
      "name": "percent-encoding of functional values preserved byte-for-byte",
      "input": "https://example.com/s?q=caf%C3%A9+cr%C3%A8me&utm_source=x&path=%2Fa%2Fb",
      "expected": "https://example.com/s?q=caf%C3%A9+cr%C3%A8me&path=%2Fa%2Fb",
      "status": "cleaned",
      "removed": ["utm_source"]
    },
    {
      "name": "unicode in path and query preserved as typed",
      "input": "https://example.com/straße?suche=größe&utm_medium=social",
      "expected": "https://example.com/straße?suche=größe",
      "status": "cleaned",
      "removed": ["utm_medium"]
    },
    {
      "name": "internationalized domain name kept as typed",
      "input": "https://bücher.example/katalog?utm_source=x&isbn=978",
      "expected": "https://bücher.example/katalog?isbn=978",
      "status": "cleaned",
      "removed": ["utm_source"]
    },
    {
      "name": "punycode domain",
      "input": "https://xn--bcher-kva.example/?gclid=1",
      "expected": "https://xn--bcher-kva.example/",
      "status": "cleaned",
      "removed": ["gclid"]
    },
    {
      "name": "port and userinfo preserved",
      "input": "http://user@example.com:8080/x?utm_source=a&b=1",
      "expected": "http://user@example.com:8080/x?b=1",
      "status": "cleaned",
      "removed": ["utm_source"]
    },
    {
      "name": "surrounding whitespace is trimmed when cleaning",
      "input": "  https://example.com/?utm_source=a  ",
      "expected": "https://example.com/",
      "status": "cleaned",
      "removed": ["utm_source"]
    },
    {
      "name": "unchanged URL returned verbatim including whitespace",
      "input": " https://example.com/?id=1 ",
      "expected": " https://example.com/?id=1 ",
      "status": "unchanged"
    },
    {
      "name": "URL without query unchanged",
      "input": "https://example.com/path/to/page",
      "expected": "https://example.com/path/to/page",
      "status": "unchanged"
    },
    {
      "name": "empty query unchanged",
      "input": "https://example.com/?",
      "expected": "https://example.com/?",
      "status": "unchanged"
    },
    {
      "name": "similar but non-tracking names preserved",
      "input": "https://example.com/?utm=1&source=web&medium=print&gclid_x=1&my_fbclid=2",
      "expected": "https://example.com/?utm=1&source=web&medium=print&gclid_x=1&my_fbclid=2",
      "status": "unchanged"
    },
    {
      "name": "tracking-looking value is not a tracking key",
      "input": "https://example.com/?q=utm_source%3Dx",
      "expected": "https://example.com/?q=utm_source%3Dx",
      "status": "unchanged"
    },
    {
      "name": "redirect parameter value is not rewritten",
      "input": "https://example.com/out?url=https%3A%2F%2Fother.example%2F%3Futm_source%3Dx&utm_campaign=y",
      "expected": "https://example.com/out?url=https%3A%2F%2Fother.example%2F%3Futm_source%3Dx",
      "status": "cleaned",
      "removed": ["utm_campaign"]
    },
    {
      "name": "invalid input",
      "input": "not a url",
      "expected": "not a url",
      "status": "invalid"
    },
    {
      "name": "empty input",
      "input": "",
      "expected": "",
      "status": "invalid"
    },
    {
      "name": "relative URL is invalid without base",
      "input": "/path?utm_source=x",
      "expected": "/path?utm_source=x",
      "status": "invalid"
    },
    {
      "name": "embedded newline rejected",
      "input": "https://example.com/?utm_source=x\nid=1",
      "expected": "https://example.com/?utm_source=x\nid=1",
      "status": "invalid"
    },
    {
      "name": "malformed host",
      "input": "https://exa mple.com/?utm_source=x",
      "expected": "https://exa mple.com/?utm_source=x",
      "status": "invalid"
    },
    {
      "name": "javascript scheme unsupported",
      "input": "javascript:alert(1)//?utm_source=x",
      "expected": "javascript:alert(1)//?utm_source=x",
      "status": "unsupported"
    },
    {
      "name": "mailto scheme unsupported",
      "input": "mailto:someone@example.com?subject=hi&utm_source=x",
      "expected": "mailto:someone@example.com?subject=hi&utm_source=x",
      "status": "unsupported"
    },
    {
      "name": "ftp scheme unsupported",
      "input": "ftp://example.com/file?utm_source=x",
      "expected": "ftp://example.com/file?utm_source=x",
      "status": "unsupported"
    },
    {
      "name": "bypass mode leaves URL untouched",
      "input": "https://example.com/?utm_source=x",
      "mode": "bypass",
      "expected": "https://example.com/?utm_source=x",
      "status": "bypassed"
    },
    {
      "name": "user exception for exact domain",
      "input": "https://example.com/?utm_source=x",
      "exceptions": ["example.com"],
      "expected": "https://example.com/?utm_source=x",
      "status": "excepted"
    },
    {
      "name": "user exception covers subdomains",
      "input": "https://news.example.com/?utm_source=x",
      "exceptions": ["example.com"],
      "expected": "https://news.example.com/?utm_source=x",
      "status": "excepted"
    },
    {
      "name": "user exception normalised from wildcard and case",
      "input": "https://shop.example.com/?utm_source=x",
      "exceptions": ["  *.EXAMPLE.com. "],
      "expected": "https://shop.example.com/?utm_source=x",
      "status": "excepted"
    },
    {
      "name": "user exception given as URL",
      "input": "https://example.com/a?utm_source=x",
      "exceptions": ["https://example.com/settings"],
      "expected": "https://example.com/a?utm_source=x",
      "status": "excepted"
    },
    {
      "name": "user exception does not match suffix-only lookalike",
      "input": "https://badexample.com/?utm_source=x",
      "exceptions": ["example.com"],
      "expected": "https://badexample.com/",
      "status": "cleaned",
      "removed": ["utm_source"]
    },
    {
      "name": "OAuth authorization request is protected",
      "input": "https://auth.example.com/oauth2/authorize?client_id=abc&redirect_uri=https%3A%2F%2Fapp.example%2Fcb&response_type=code&state=xyz&utm_source=mail",
      "expected": "https://auth.example.com/oauth2/authorize?client_id=abc&redirect_uri=https%3A%2F%2Fapp.example%2Fcb&response_type=code&state=xyz&utm_source=mail",
      "status": "protected",
      "reason": "path:oauth"
    },
    {
      "name": "OAuth callback with code and state is protected",
      "input": "https://app.example/welcome?code=SplxlOBeZQQYbYS6WxSbIA&state=af0ifjsldkj&utm_source=x",
      "expected": "https://app.example/welcome?code=SplxlOBeZQQYbYS6WxSbIA&state=af0ifjsldkj&utm_source=x",
      "status": "protected",
      "reason": "combination:code+state"
    },
    {
      "name": "code alone is not protected (promo codes)",
      "input": "https://shop.example/deal?code=SUMMER&utm_source=x",
      "expected": "https://shop.example/deal?code=SUMMER",
      "status": "cleaned",
      "removed": ["utm_source"]
    },
    {
      "name": "OIDC implicit flow token in fragment is protected",
      "input": "https://app.example/landing?utm_source=x#id_token=eyJabc&state=1",
